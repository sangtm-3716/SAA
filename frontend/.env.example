# Local Supabase (`supabase start` prints these; the anon key is the fixed local demo key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key printed by `supabase start`>

# Countdown / prelaunch page (optional, SERVER-ONLY — do NOT prefix with
# NEXT_PUBLIC_, or the override reaches the browser bundle). When set to a
# valid ISO 8601 datetime, overrides the `event_settings` table read and is
# the knob the E2E test harness uses to drive the navigation lock.
# EVENT_STARTS_AT=2026-12-01T02:00:00.000Z
